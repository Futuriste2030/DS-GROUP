# BS GROUP — Variables d'environnement PRODUCTION (SQLite)
# Copier vers .env.prod et remplir TOUTES les valeurs (ne jamais committer .env.prod)

# === Django Core ===
SECRET_KEY=your-very-long-random-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=bsgroup.ml,www.bsgroup.ml
CSRF_TRUSTED_ORIGINS=https://bsgroup.ml,https://www.bsgroup.ml
CANONICAL_DOMAIN=bsgroup.ml

# === Base de données (SQLite) ===
# Le fichier DB est stocké dans le volume Docker 'sqlite_data' → /data/db.sqlite3
# Aucune variable POSTGRES_* nécessaire

# === Email (SMTP production) ===
DEFAULT_FROM_EMAIL=noreply@bsgroup.ml
EMAIL_FROM_NAME=BS GROUP
CONTACT_EMAIL=contact@bsgroup.ml
CAREERS_EMAIL=careers@bsgroup.ml
HR_EMAIL=hr@bsgroup.ml
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True

# === Chatbot (Gemini) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# === Cookies / Consentement ===
COOKIE_POLICY_VERSION=1.0
CONSENT_RETENTION_DAYS=182

# === Superuser initial (optionnel, pour premier déploiement) ===
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@bsgroup.ml
# DJANGO_SUPERUSER_PASSWORD=your-admin-password

# === Monitoring / Sentry (optionnel) ===
# SENTRY_DSN=https://xxx@sentry.io/xxx

# === CDN / Stockage media (optionnel, si S3/Cloudflare R2) ===
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_STORAGE_BUCKET_NAME=bsgroup-media
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_CUSTOM_DOMAIN=cdn.bsgroup.ml